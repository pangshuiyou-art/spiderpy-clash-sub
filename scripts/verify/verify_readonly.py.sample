"""源项目只读保护校验脚本（模板，脱敏版）。

在项目任何阶段开始前/结束后校验源项目未被改动：
工作区状态干净 + HEAD 提交未变 + 全部被跟踪文件的联合哈希一致。
三者任一变化（包括"改完又提交"的情况）都会暴露。

用法:
    python scripts/verify/verify_readonly.py --before  # 阶段开始前：校验并记录快照
    python scripts/verify/verify_readonly.py --after   # 阶段结束后：与快照逐项比对
    python scripts/verify/verify_readonly.py --compare # 仅打印当前状态摘要（排查用）

配置（复制到项目后必须修改）:
    SOURCE_ROOT : 源项目绝对路径
    HASH_RECORD : 快照记录文件路径（JSON；连同文件名加入 .gitignore）
"""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

# ============ 复制到项目后修改以下两处 ============
SOURCE_ROOT = Path(r'{{源项目绝对路径}}')           # 例: Path(r'E:\Users\...\SourceProj')
HASH_RECORD = Path(__file__).parent / '{{源项目}}_hash_record.json'
# ==================================================


def _config_unset() -> bool:
    """检测脚本顶部的 SOURCE_ROOT / HASH_RECORD 是否仍是 {{...}} 占位符。

    用户复制模板后常忘记改这两处，若未改则给出精准提示，避免把
    「配置未改」误报成「目录不存在」。
    """
    return '{{' in str(SOURCE_ROOT) or '{{' in str(HASH_RECORD)


def run_git(args: list[str]) -> str:
    """在源项目目录执行 git 命令并返回 stdout。

    git 不可用或源项目不是 git 仓库时直接判失败退出，
    防止"命令报错、stdout 为空"被误当成"状态干净"。
    """
    result = subprocess.run(
        ['git', *args],
        cwd=SOURCE_ROOT,
        capture_output=True,
        text=True,
        encoding='utf-8',
        errors='replace',
        check=False,
    )
    if result.returncode != 0:
        print(f'[FAIL] git {" ".join(args)} 执行失败（退出码 {result.returncode}）:')
        print(result.stderr.strip() or '（无 stderr 输出）')
        print('常见原因: 源项目不是 git 仓库 / 未安装 git / SOURCE_ROOT 路径配置错误')
        sys.exit(1)
    return result.stdout


def capture_state() -> dict[str, Any]:
    """采集源项目当前状态快照：HEAD、工作区状态、全部被跟踪文件的联合哈希。"""
    head = run_git(['rev-parse', 'HEAD']).strip()
    status = run_git(['status', '--porcelain']).strip()
    tracked_files = sorted(run_git(['ls-files']).splitlines())

    hasher = hashlib.sha256()
    file_count = 0
    for rel_path in tracked_files:
        file_path = SOURCE_ROOT / rel_path
        if not file_path.is_file():
            continue  # 子模块/特殊对象跳过
        hasher.update(rel_path.encode('utf-8'))
        hasher.update(file_path.read_bytes())
        file_count += 1

    return {
        'head': head,
        'status_clean': not status,
        'status': status,
        'manifest_hash': hasher.hexdigest(),
        'file_count': file_count,
        'recorded_at': datetime.now().isoformat(timespec='seconds'),
    }


def verify_before() -> bool:
    """阶段开始前：确认源项目 git 状态干净，并记录 HEAD + 全量文件哈希快照。"""
    print('[Before] 校验源项目 git 状态...')
    state = capture_state()
    if not state['status_clean']:
        print(f"[FAIL] 源项目存在未提交修改:\n{state['status']}")
        print('请先处理源项目的修改后再开始本阶段')
        return False
    print('[OK] 源项目 git 状态干净')

    HASH_RECORD.write_text(
        json.dumps(state, ensure_ascii=False, indent=2), encoding='utf-8'
    )
    print(f"[OK] 快照已记录: HEAD={state['head'][:12]}..., "
          f"被跟踪文件 {state['file_count']} 个, 哈希 {state['manifest_hash'][:16]}...")
    return True


def verify_after() -> bool:
    """阶段结束后：确认源项目工作区、HEAD、全量文件哈希均与快照一致。"""
    print('[After] 校验源项目未被改动...')
    if not HASH_RECORD.exists():
        print('[WARN] 无前置快照记录，仅校验当前工作区状态')
        state = capture_state()
        return bool(state['status_clean'])

    before = json.loads(HASH_RECORD.read_text(encoding='utf-8'))
    current = capture_state()

    failures: list[str] = []
    if not current['status_clean']:
        failures.append(f"工作区出现未提交修改:\n{current['status']}")
    if current['head'] != before['head']:
        failures.append(f"HEAD 变化: {before['head'][:12]}... -> {current['head'][:12]}...")
    if current['manifest_hash'] != before['manifest_hash']:
        failures.append(
            f"被跟踪文件哈希变化: {before['manifest_hash'][:16]}... -> "
            f"{current['manifest_hash'][:16]}...（文件数 {before['file_count']} -> {current['file_count']}）"
        )

    if failures:
        print('[FAIL] 源项目被改动，严重违反只读保护原则:')
        for item in failures:
            print(f'  - {item}')
        return False

    print(f"[OK] 源项目零改动: HEAD={current['head'][:12]}..., "
          f"哈希 {current['manifest_hash'][:16]}... 与快照一致")
    return True


def main() -> int:
    parser = argparse.ArgumentParser(description='源项目只读保护校验')
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument('--before', action='store_true', help='阶段开始前校验并记录快照')
    group.add_argument('--after', action='store_true', help='阶段结束后与快照比对')
    group.add_argument('--compare', action='store_true', help='仅打印当前状态摘要')
    args = parser.parse_args()

    if _config_unset():
        print('[FAIL] 脚本顶部 SOURCE_ROOT / HASH_RECORD 仍是 {{...}} 占位符。')
        print('请先编辑脚本顶部两处配置（复制为 verify_readonly.py 后再修改）。')
        return 1

    if not SOURCE_ROOT.exists():
        print(f'[FAIL] 源项目目录不存在: {SOURCE_ROOT}')
        print('请先修改脚本顶部 SOURCE_ROOT 配置')
        return 1

    if args.before:
        return 0 if verify_before() else 1
    if args.after:
        return 0 if verify_after() else 1

    state = capture_state()
    print(f"HEAD: {state['head']}")
    print(f"工作区状态: {'干净' if state['status_clean'] else '存在未提交修改'}")
    print(f"被跟踪文件 {state['file_count']} 个, 联合哈希: {state['manifest_hash']}")
    return 0


if __name__ == '__main__':
    sys.exit(main())
