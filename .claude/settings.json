{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import json,sys; print(json.dumps({'sessionStart':True,'additionalContext':open('.memory/MEMORY.md',encoding='utf-8').read()}))\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}