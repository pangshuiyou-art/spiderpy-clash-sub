{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,sys; root=os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(); sys.stdout.write(open(os.path.join(root,'.memory','MEMORY.md'),encoding='utf-8').read())\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
