# 工具链配置模板 —— 复制到项目根目录后改名 pyproject.toml，按实际增删
# 作用：把 CLAUDE.md §4.1 的「行长 ≤ 120、单引号优先」落到工具层，
#       避免文档规则与工具默认行为打架（black 默认双引号 + 行长 88 会反向改掉单引号代码）。

[project]
# name = "{{包名}}"
# version = "0.1.0"
# requires-python = ">=3.12"
# dependencies = []

[tool.ruff]
line-length = 120
target-version = "py312"

[tool.ruff.lint]
# E/F：pycodestyle+pyflakes；I：导入排序；B：bugbear 常见坑；UP：新版本语法提示
select = ["E", "F", "I", "B", "UP"]

[tool.black]
line-length = 120
# 保留作者的单引号写法，与 CLAUDE.md §4.1「单引号优先」一致（black 默认会统一成双引号）
skip-string-normalization = true

[tool.pytest.ini_options]
testpaths = ["tests"]
# -ra: 摘要显示跳过/失败原因；--strict-markers: 未注册的 marker 直接报错
addopts = "-ra --strict-markers"

# ===== 覆盖率（pytest-cov，与 AGENTS.md「覆盖率≥70%」对应）=====
# 启用时取消注释，把 {{包名}} 替换为实际的 Python 包目录名
# [tool.coverage.run]
# source = ["{{包名}}"]
# omit = [
#     "{{包名}}/*_test.py",
#     "tests/*",
# ]
#
# [tool.coverage.report]
# show_missing = true
# skip_covered = false
# # 覆盖率阈值（与用户规则「≥70%」一致，不达标时 pytest 退出码非 0，强制阻塞提交）
# fail_under = 70
# exclude_lines = [
#     "pragma: no cover",
#     "if TYPE_CHECKING:",
#     "raise NotImplementedError",
# ]

# ===== 可选：静态类型检查（mypy，按项目需要启用）=====
# [tool.mypy]
# python_version = "3.12"
# strict = true
# warn_return_any = true
# warn_unused_configs = true
# disallow_untyped_defs = true
# ignore_missing_imports = false
